# Daily English Environment Variables Template
# หมายเหตุ: ห้ามใส่ OpenRouter API Key ใน VITE_* เพราะค่าจะถูกฝังใน JavaScript ฝั่ง client
# ผู้ใช้ที่ต้องการ OpenRouter BYOK ให้กรอกคีย์ผ่านหน้า Settings เท่านั้น

# API Base URL (เว้นว่างเพื่อใช้ same-origin serverless proxy ที่ /api/openrouter)
VITE_API_BASE_URL=

# App Environment (development / staging / production)
VITE_APP_ENV=development

# Default Language & Fallback Timezone
VITE_DEFAULT_TIMEZONE=Asia/Bangkok
