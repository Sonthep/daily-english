# Daily English Environment Variables Template
# หมายเหตุ: ใน Phase 1 เว็บแอปพลิเคชันทำงานแบบ Local-First ไม่จำเป็นต้องมี API Key ใดๆ
# สำหรับ Phase 2 เมื่อเปิดใช้งาน Remote AI Backend สามารถกำหนดค่าตัวแปรเหล่านี้ได้

# Optional: Google Gemini API Key for AI Coach & Pronunciation Evaluation
# สามารถกำหนดที่นี่ หรือกรอกผ่านหน้า Settings ในเว็บแอปได้เช่นกัน
VITE_GEMINI_API_KEY=

# Backend API Base URL (สำหรับ Phase 2 Remote Tutor Service)
VITE_API_BASE_URL=

# App Environment (development / staging / production)
VITE_APP_ENV=development

# Default Language & Fallback Timezone
VITE_DEFAULT_TIMEZONE=Asia/Bangkok
